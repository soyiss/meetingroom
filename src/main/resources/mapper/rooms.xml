<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.meetingroom.mapper.RoomsMapper">

    <!--
       CREATE TABLE room (
                       id BIGSERIAL PRIMARY KEY,
                       name VARCHAR(50) NOT NULL,
                       capacity INT
);
     -->

    <!--  회의실목록전체조회-->
    <select id="findAllRooms"
            resultType="com.project.meetingroom.domain.Rooms">
        select id,name,capacity  from rooms
    </select>

    <!--  회의실 1개 조회 -->
    <select id="findByRooms"
            resultType="com.project.meetingroom.domain.Rooms">
        select id,name,capacity  from rooms where id = #{id}
    </select>


</mapper>