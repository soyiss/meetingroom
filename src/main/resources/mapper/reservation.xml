<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.meetingroom.mapper.ReservationMapper">

    <!--
        CREATE TABLE reservation (
                             id BIGSERIAL PRIMARY KEY,
                             room_id BIGINT REFERENCES rooms(id),
                             user_id BIGINT REFERENCES users(id),
                             reserve_date DATE NOT NULL,
                             start_time TIME NOT NULL,
                             end_time TIME NOT NULL,
                             status VARCHAR(20) NOT NULL DEFAULT '예약완료'  →  예약완료 / 예약취소
);
        -->
    <!--예약하려는 시간에 이미 예약이 있는지 검사-->
    <select id="countOverlap"
            parameterType="com.project.meetingroom.domain.Reservation"
            resultType="int">

        SELECT COUNT(*)
        FROM reservation
        WHERE room_id = #{roomId}
          AND reserve_date = #{reserveDate}
          AND status = '예약완료'
          AND start_time <![CDATA[ < ]]> #{endTime}
          AND end_time <![CDATA[ > ]]> #{startTime}

    </select>

    <insert id="insertReservation"
            parameterType="com.project.meetingroom.domain.Reservation">

        INSERT INTO reservation
        (
            room_id,
            user_id,
            reserve_date,
            start_time,
            end_time,
            status
        )
        VALUES
            (
                #{roomId},
                #{userId},
                #{reserveDate},
                #{startTime},
                #{endTime},
                '예약완료'
            )

    </insert>
</mapper>